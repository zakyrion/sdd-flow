{
  "name": "sdd-flow",
  "version": "0.3.4",
  "private": true,
  "description": "Spec-Driven Development workflow for AI coding agents (Claude Code and Codex): every request becomes an explicit contract with a gated Research -> Plan -> Execute lifecycle and a persistent FLOW document.",
