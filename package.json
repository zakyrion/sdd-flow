    "sdd-flow": "./bin/sdd-flow.js"
  },
  "scripts": {
    "test": "node --test",
    "doctor": "node ./bin/sdd-flow.js doctor .",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
